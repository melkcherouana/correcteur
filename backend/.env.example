# Base de données PostgreSQL
DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/evalpro"

# URL de connexion directe (hors pooler) — requise en prod avec un pooler
# type pgbouncer (ex: Supabase) pour que `prisma migrate deploy` fonctionne.
# En local avec Postgres direct, laisser identique à DATABASE_URL.
DIRECT_URL="postgresql://postgres:motdepasse@localhost:5432/evalpro"

# Serveur
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire
JWT_EXPIRES_IN=7d

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# CORS
FRONTEND_URL=http://localhost:5173
